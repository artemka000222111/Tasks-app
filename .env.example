# Скопируй в .env и заполни. Файл .env в git НЕ попадает.
# На Railway эти значения задаются в Variables, а не в файле.

# Токен бота от @BotFather
BOT_TOKEN=

# Railway сам подставит DATABASE_URL при подключении Postgres.
# Локально можно оставить sqlite:
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Комиссия платформы в процентах (сверху к награде исполнителям)
COMMISSION_PERCENT=10

# ТОЛЬКО для локальной разработки: вход без Telegram и тестовое пополнение баланса
DEV_MODE=false
